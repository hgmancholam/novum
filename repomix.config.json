{
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "showLineNumbers": false,
    "copyToClipboard": false,
    "topFilesLength": 20
  },
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "backend/.venv/**",
      "frontend/node_modules/**",
      "frontend/dist/**",
      "frontend/coverage/**",
      "**/__pycache__/**",
      "**/*.pyc",
      "**/*.pyo",
      "alembic/versions/**",
      "eval_*.txt",
      "compare_*.txt",
      "compare_*.json",
      "repomix-output.xml",
      ".claude/session.*",
      "*.log"
    ]
  },
  "include": [
    "backend/app/**",
    "frontend/src/**",
    "docs/**",
    ".github/memory-bank/**",
    ".github/copilot-instructions.md",
    "CLAUDE.md"
  ]
}
