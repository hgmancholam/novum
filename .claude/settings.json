{
  "permissions": {
    "allow": [
      "Bash(python -c ' *)",
      "Bash(awk 'NR==95,NR==175' backend/app/domain/enums.py)",
      "Bash(npx tsc *)",
      "mcp__chrome-devtools__navigate_page",
      "mcp__chrome-devtools__evaluate_script"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/lint_gate.py"
          },
          {
            "type": "command",
            "command": "python .claude/hooks/eval_gate_detector.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/memory_enforcer.py"
          }
        ]
      }
    ]
  }
}
